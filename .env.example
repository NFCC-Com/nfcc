# ─── Supabase Postgres (Drizzle) ────────────────────────────────────────────
# Project → Settings → Database → Connection string.
# DATABASE_URL: transaction pooler (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# DIRECT_URL: session pooler / direct (port 5432) — used by drizzle-kit for migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth + Storage ─────────────────────────────────────────────────
# Project → Settings → API Keys. Uses the NEW key format.
SUPABASE_URL="https://<project-ref>.supabase.co"
# Publishable key (sb_publishable_…) — safe for the browser / auth flows.
# (Legacy fallback: SUPABASE_ANON_KEY is still read if this is unset.)
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Secret key (sb_secret_…): SERVER-ONLY. Never expose to the client. Used for image
# uploads and privileged writes in src/server/admin.ts.
# (Legacy fallback: SUPABASE_SERVICE_ROLE_KEY is still read if this is unset.)
SUPABASE_SECRET_KEY="sb_secret_..."

# Name of the public Storage bucket for uploaded images (create it in the dashboard).
SUPABASE_STORAGE_BUCKET="media"
